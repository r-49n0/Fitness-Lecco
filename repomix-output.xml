export default function DynamicSchedule({ onOpenLightbox }) {
  const [selectedCategory, setSelectedCategory] = useState('All');
  const [selectedDay, setSelectedDay] = useState('Lunedì');

  const categories = ['All', 'Cardio', 'Strength', 'Functional', 'Personal Training'];
  const days = ['Lunedì', 'Martedì', 'Mercoledì', 'Giovedì', 'Venerdì', 'Sabato'];

  const filteredCourses = COURSES_DATA.filter((course) => {
    const categoryMatch = selectedCategory === 'All' || course.category === selectedCategory;
    const dayMatch = selectedDay === 'All' || course.day === selectedDay;
    return categoryMatch && dayMatch;
  });

  return (
    <section id="corsi" className="section-dark">
      <div className="container">
        
        {/* Section Header */}
