import React, { useState } from 'react';
import Navbar from './components/Navbar';
import HeroShowcase from './components/HeroShowcase';
import DynamicSchedule, { COURSES_DATA } from './components/DynamicSchedule';
import ExperiencePreviewLightbox from './components/ExperiencePreviewLightbox';
import AbbonamentiSection from './components/AbbonamentiSection';
import SocialProofCommunity from './components/SocialProofCommunity';
import LocationContacts from './components/LocationContacts';
import Footer from './components/Footer';

export default function App() {
  const [activeTab, setActiveTab] = useState('home');
  const [lightboxItem, setLightboxItem] = useState(null);

  const handleOpenLightbox = (courseItem) => {
    setLightboxItem(courseItem);
  };

  const handleCloseLightbox = () => {
    setLightboxItem(null);
  };

  const scrollToSection = (id) => {
    setActiveTab(id);
    const element = document.getElementById(id);
    if (element) {
      element.scrollIntoView({ behavior: 'smooth' });
    }
  };

  const handleOpenTrialBooking = () => {
    // Select first course as default for booking or open contact section
    handleOpenLightbox(COURSES_DATA[0]);
  };

  return (
    <div style={{ backgroundColor: 'var(--bg-main)', minHeight: '100vh', color: 'var(--text-primary)' }}>
      
      {/* Top Fixed Header */}
      <Navbar 
        activeTab={activeTab} 
        setActiveTab={setActiveTab} 
        onBookClick={handleOpenTrialBooking} 
      />

      {/* 1. Hero Showcase Section */}
      <HeroShowcase 
        onExploreCourses={() => scrollToSection('corsi')} 
        onBookTrial={handleOpenTrialBooking} 
      />

      {/* 2. Dynamic Schedule & Course Catalog */}
      <DynamicSchedule 
        onOpenLightbox={handleOpenLightbox} 
      />

      {/* 3. Membership & Abbonamenti */}
      <AbbonamentiSection 
        onSelectPlan={(plan) => handleOpenLightbox({
          title: `ABBONAMENTO ${plan.name}`,
          category: plan.name,
          time: 'Accesso Riservato',
          duration: 'Mensile',
          room: 'Tutte le aree del club',
          trainer: 'Staff Fitness Lecco',
          image: '/hero_gym.png',
          description: plan.subtitle,
          equipment: plan.features.join(', '),
          target: `Prezzo promozionale €${plan.price}/mese`
        })}
      />

      {/* 4. Social Proof & Community */}
      <SocialProofCommunity />

      {/* 5. Location & Contacts */}
      <LocationContacts />

      {/* Footer */}
      <Footer onNavClick={scrollToSection} />

      {/* Experience Preview Dark Lightbox Modal */}
      {lightboxItem && (
        <ExperiencePreviewLightbox 
          item={lightboxItem} 
          onClose={handleCloseLightbox} 
        />
      )}

    </div>
  );
}
</file>

